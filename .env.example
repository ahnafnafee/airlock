# Copy this file to .env on the VPS. It contains configuration only; export
# TS_AUTHKEY in the shell for the first start instead of saving it here.
AIRLOCK_HOSTNAME=airlock
AIRLOCK_DATA_VOLUME=airlock-data
AIRLOCK_TTL_HOURS=24
AIRLOCK_MAX_TOTAL=214748364800
AIRLOCK_VAPID_SUBJECT=mailto:you@example.com

# Usually blank: an untagged embedded node defaults to the Tailscale account
# that enrolled it. Set the exact login when the server uses a tagged auth key
# or when more than one tailnet user should be admitted.
AIRLOCK_ALLOW_USERS=
AIRLOCK_ALLOW_NODES=
